<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinViewModel.Event" />

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvNext"
            android:layout_marginBottom="20dp"
            >

            <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/HeadLine20B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:text="프로필 이미지"
                    android:textColor="@color/black_80" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/background_s_green5_r4"
                    android:padding="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCheck"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/fillcircle_check_green"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Paragraph14R"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:text="실물 사진을 등록하시면 신뢰도가 상승하여, 더 많은 매칭 기회를 얻을 수 있어요."
                        android:textColor="@color/green_100"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivCheck" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clImage"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/background_s_b5_r4"
                    android:onClick="@{()-> viewModel.onEventClick(Event.AttachImage.INSTANCE)}">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivSelectedImage"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:clipToOutline="true"
                        android:scaleType="fitXY"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCamera"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/camera"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvAddImage"
                        style="@style/Paragraph12R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="사진 추가"
                        android:textColor="@color/black_60"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:text="자기소개"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etIntroduce"
                    style="@style/Paragraph14R"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/background_st_b10_s_w_r4"
                    android:gravity="top|left"
                    android:hint="동행 업무 관련하여 본인을 소개해 주세요."
                    android:maxLength="200"
                    android:padding="8dp"
                    android:textColor="@color/black_80"
                    android:textColorHint="@color/black_40" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/200"
                        android:textColor="@color/black_40"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    style="@style/Paragraph16B"
                    android:textColor="@color/black_80"
                    android:text="범죄경력회부서 제출"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRegisterCRC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_s_b5_r4"
                        android:paddingVertical="16dp"
                        style="@style/Paragraph14B"
                        android:enabled="@{viewModel.isCrcAgree}"
                        android:selected="@{viewModel.isCrcAgree}"
                        android:textColor="@color/selector_black20_b80"
                        android:text="범죄경력회부서 등록"
                        android:gravity="center"
                        android:visibility="visible"
                        tools:visibility="visible"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCRCfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/background_s_b5_r4"
                        android:paddingVertical="16dp"
                        style="@style/Paragraph14B"
                        android:enabled="@{viewModel.isCrcAgree}"
                        android:selected="@{viewModel.isCrcAgree}"
                        android:textColor="@color/selector_black20_b80"
                        android:text="fileName.pdf"
                        android:gravity="center"
                        android:visibility="gone"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvReRegisterCRC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:background="@drawable/background_s_p100_r4"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="16dp"
                        style="@style/Paragraph14B"
                        android:textColor="@color/white"
                        android:text="재등록"
                        android:gravity="center"
                        android:visibility="gone"
                        />
                </LinearLayout>

                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center_vertical"
                    >
                    <CheckBox
                        android:id="@+id/cbAgree"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:button="@null"
                        android:background="@drawable/checkbox_selector"
                        android:onCheckedChanged="@{(button, isChecked) -> viewModel.onCrcAgreeChanged(isChecked)}"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:text="범죄경력회부서 제출에 동의합니다."
                        android:textColor="@color/black_80"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:textColor="@color/black_40"
                        android:text="·"
                        style="@style/Paragraph14B"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Paragraph14R"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/black_40"
                        android:text="생활물류서비스산업발전법 제19조의2 및 제19조의3에 따라 플레이어 신청 시 반드시 ‘범죄 경력 회보서 발급 시스템(https://crims.police.go.kr/)’에서 발급 받은 범죄 경력 회보서를 제출해야 합니다."
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:textColor="@color/black_40"
                        android:text="·"
                        style="@style/Paragraph14B"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Paragraph14R"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/black_40"
                        android:text="범죄경력회부서는 플레이어 자격 확인 목적으로만 이용되며, 확인 후 즉시 파기됩니다."
                        />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNext"
            style="@style/HeadLine20B"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_cta_height"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/selector_b20_p100_r4"
            android:gravity="center"
            android:enabled="@{viewModel.enableStep3Next}"
            android:onClick="@{()-> viewModel.onClickStepNext(4)}"
            android:text="다음"
            android:textColor="@color/selector_wopa40_wopa100"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>