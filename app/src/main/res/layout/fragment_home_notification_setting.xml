<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">
        <LinearLayout
            android:id="@+id/clTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/left_l" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph16B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="알림 설정"
                android:textColor="@color/black_80" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/clTop">
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph16B"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="앱 알림"
                android:textColor="@color/black_80" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swPush"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:paddingHorizontal="20dp"
                android:text="푸시 알림 받기"
                android:textColor="@color/black_80"
                android:textSize="15dp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swChat"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:paddingHorizontal="20dp"
                android:text="채팅 알림 받기"
                android:textColor="@color/black_80"
                android:textSize="15dp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDelivery"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:paddingHorizontal="20dp"
                android:text="배송 알림 받기"
                android:textColor="@color/black_80"
                android:textSize="15dp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swMarketing"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:paddingHorizontal="20dp"
                android:text="혜택 정보 알림 받기"
                android:textColor="@color/black_80"
                android:textSize="15dp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:paddingHorizontal="20dp"
                android:text="야간 알림 받기"
                android:textColor="@color/black_80"
                android:textSize="15dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
