<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="sky.kr.co.newtogetusa.ui.main.my.MySettingViewModel.Event" />

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.my.MySettingViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Topbar start-->
        <LinearLayout
            android:id="@+id/clTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:onClick="@{()->viewModel.onEventClick(Event.Back.INSTANCE)}"
                android:src="@drawable/left_l" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="프로필 관리"
                android:textColor="@color/black_80"
                android:textSize="16dp"
                android:textStyle="bold" />

        </LinearLayout>
        <!-- Topbar end-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.ManageProfile.INSTANCE)}"
            android:paddingHorizontal="20dp">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/HeadLine18B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필 관리"
                android:textColor="@color/black_80"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/right_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/black_5" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.BlockManagement.INSTANCE)}">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/HeadLine18B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차단 관리"
                android:textColor="@color/black_80"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/right_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/black_2" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Paragraph12B"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="알림 설정"
            android:textColor="@color/black_40" />

        <!-- 배송알림 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="배송 알림"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="배송 배송을 위한 관련 알림 수신"
                    android:textColor="@color/black_40" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDelivery"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/black_5" />

        <!-- 채팅알림 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="채팅 알림"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="채팅 메시지 수신"
                    android:textColor="@color/black_40" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swChatting"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/black_5" />

        <!-- 혜택 정보 알림 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="혜택 정보 알림"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이벤트 및 마케팅 정보 수신"
                    android:textColor="@color/black_40" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swMarketing"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/black_5" />

        <!-- 야간 혜택 알림 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="야간 혜택 동의"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph14R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오후 09:00~오전 08:00 알림 발송"
                    android:textColor="@color/black_40" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNight"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/black_2" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            android:onClick="@{()-> viewModel.onEventClick(Event.Logout.INSTANCE)}"
            android:text="로그아웃"
            android:textColor="@color/black_80" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/black_5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            android:onClick="@{()-> viewModel.onEventClick(Event.WithDraw.INSTANCE)}"
            android:text="탈퇴하기"
            android:textColor="@color/red_100" />

    </LinearLayout>
</layout>
