<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.text.TextUtils"/>
        <import type="android.view.View"/>
        <import type="sky.kr.co.newtogetusa.ui.main.delivery.DeliveryAddressMapViewModel.Event"/>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.delivery.DeliveryAddressMapViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/clTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/left_l"
                android:onClick="@{()->viewModel.onEventClick(Event.Back.INSTANCE)}"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="16dp"
                android:textColor="@color/black_80"
                android:textStyle="bold"
                android:text="지도에서 주소 찾기"
                />
        </LinearLayout>

        <com.kakao.vectormap.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/clTop"
            app:layout_constraintBottom_toTopOf="@id/llBottomPanel"
            android:visibility="@{viewModel.isInternationalDelivery?View.GONE : View.VISIBLE}"
            />

        <com.google.android.gms.maps.MapView
            android:id="@+id/googleMap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/clTop"
            app:layout_constraintBottom_toTopOf="@id/llBottomPanel"
            android:visibility="@{viewModel.isInternationalDelivery?View.VISIBLE : View.GONE}"
            />

        <LinearLayout
            android:id="@+id/llBottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical"
            android:background="@color/white"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:textSize="20dp"
                android:textColor="@color/black_80"
                android:textStyle="bold"
                android:text="@{TextUtils.isEmpty(viewModel.selectedAddress.roadAddress)?viewModel.selectedAddress.name:viewModel.selectedAddress.roadAddress}"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:textSize="16dp"
                android:textColor="@color/black_60"
                android:text="@{viewModel.uiSelectedAddressName}"
                />
            
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottom_cta_height"
                android:layout_marginHorizontal="20dp"
                android:layout_marginVertical="20dp"
                android:text="위 주소로 지정"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:textStyle="bold"
                android:background="@drawable/selector_b20_p100_r4"
                android:gravity="center"
                android:onClick="@{()-> viewModel.onEventClick(Event.SetAddress.INSTANCE)}"
                />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>