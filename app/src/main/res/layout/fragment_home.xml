<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- top bar start -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTop"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_logo"
            />
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="20dp"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_bell"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="19dp"
                android:layout_height="19dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_primary100_r24"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:text="3"
                    style="@style/Description9B"
                    tools:text="3"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- topbar end -->

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBanner"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toBottomOf="@id/clTop"
        android:layout_margin="20dp"
        android:src="@drawable/temp_banner_area"
        android:scaleType="fitXY"
        />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/ivBanner"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:text="동네에서 해외까지, 전국민 물품 배송중개"
                style="@style/HeadLine20B"
                android:textColor="@color/black_80"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMainDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvMainTitle"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="20dp"
                android:text="플레이어가 저렴하고 안전하게 배송해드려요."
                style="@style/Paragraph16R"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvMainDesc"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/home"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvReqDelivery"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:layout_constraintTop_toBottomOf="@id/ivMain"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="배송 요청하기"
                android:textColor="@color/white"
                android:background="@drawable/selector_b20_b80_r4"
                />

            <View
                android:id="@+id/vDivider"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvReqDelivery"
                android:layout_marginTop="20dp"
                android:background="@color/black_2"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/vDivider"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRegistered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/rvProgress"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                />

            <LinearLayout
                android:id="@+id/llJoinPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/rvRegistered"
                android:paddingBottom="20dp"
                android:orientation="vertical">
                <View
                    android:id="@+id/vDiv"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tvReqDelivery"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_2"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    style="@style/Paragraph12R"
                    android:gravity="center"
                    android:text="이동 경로를 따라서 시작해보세요!"
                    android:textColor="@color/black_80"
                    />
                
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="20dp"
                    android:text="플레이어 신청"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/background_s_b80_r4"
                    />
                
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>