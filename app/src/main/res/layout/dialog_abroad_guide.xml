<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <import type="sky.kr.co.newtogetusa.ui.dialog.message.AbroadGuideViewModel.Event"/>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.dialog.message.AbroadGuideViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Paragraph16B"
            android:layout_gravity="center"
            android:text="해외 배송 안내"
            android:textColor="@color/black_80"
            android:layout_marginTop="20dp"
            />


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Paragraph14B"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/black_80"
            android:text="1. 국가별 제한 품목 확인 필수"
            android:layout_marginTop="12dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            style="@style/Paragraph12R"
            android:textColor="@color/black_40"
            android:text="해외 배송 시 수·출입이 금지되거나 제한된 물품이 국가마다 다를 수 있습니다. 출발지 및 도착지 국가의 제한 품목을 반드시 확인해 주세요."
            android:background="@drawable/background_s_b5_r4"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Paragraph14B"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/black_80"
            android:text="2. 세관 및 통관 관련 이슈"
            android:layout_marginTop="12dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            style="@style/Paragraph12R"
            android:textColor="@color/black_40"
            android:text="물품의 통관 여부, 세관 검수, 관세 부과 등은 각국의 법령과 규정에 따라 다르며, 이에 따른 지연, 반송, 추가 비용 등의 발생 가능성이 있습니다."
            android:background="@drawable/background_s_b5_r4"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Paragraph14B"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/black_80"
            android:text="3. 당사자 책임 원칙"
            android:layout_marginTop="12dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            style="@style/Paragraph12R"
            android:textColor="@color/black_40"
            android:text="국가별 규정 미확인으로 인한 문제(세관 반입 불가, 압류, 지연, 벌금 등)는 해당 거래 당사자 간(유저–플레이어) 책임이며, 플랫폼은 이에 대한 책임을 지지 않습니다."
            android:background="@drawable/background_s_b5_r4"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Paragraph14B"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/black_80"
            android:text="4. 분쟁 또는 사고 발생 시"
            android:layout_marginTop="12dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            style="@style/Paragraph12R"
            android:textColor="@color/black_40"
            android:text="거래 당사자 간의 협의를 우선하며, 필요 시 플랫폼은 중재를 위한 정보 제공만 지원합니다."
            android:background="@drawable/background_s_b5_r4"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="20dp"
            android:onClick="@{()-> viewModel.onAgreeCheck(!viewModel.isAgreeChecked)}"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@null"
                android:background="@drawable/checkbox_selector"
                android:checked="@{viewModel.isAgreeChecked}"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                style="@style/Paragraph14R"
                android:text="위 내용을 모두 확인하였으며, 안내 사항에 동의합니다."
                android:textColor="@color/black_80"
                />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/black_10"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                style="@style/Paragraph16B"
                android:text="취소"
                android:textColor="@color/black_40"
                android:gravity="center"
                android:layout_weight="1"
                android:onClick="@{()-> viewModel.onEventClick(Event.Cancel.INSTANCE)}"
                />
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/black_10"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                style="@style/Paragraph16B"
                android:text="동의하기"
                android:textColor="@{viewModel.isAgreeChecked ? @color/black_40: @color/black_20}"
                android:gravity="center"
                android:layout_weight="1"
                android:clickable="@{viewModel.isAgreeChecked}"
                android:onClick="@{() -> viewModel.onEventClick(Event.Agree.INSTANCE)}"
                />
        </LinearLayout>
    </LinearLayout>

</layout>