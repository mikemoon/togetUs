<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="sky.kr.co.newtogetusa.ui.main.my.MyViewModel.Event" />

        <variable
            name="profile"
            type="sky.kr.co.newtogetusa.data.remote.dto.users.ProfileDto" />

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.my.MyViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTop"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/HeadLine20B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="My"
                android:textColor="@color/black_80"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="20dp"
                android:onClick="@{()-> viewModel.onEventClick(Event.MySetting.INSTANCE)}"
                android:src="@drawable/ic_setting"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clFixedProfile"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.ProfileManage.INSTANCE)}"
            app:layout_constraintTop_toBottomOf="@id/clTop">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivFixedProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:loadProfile="@{profile.user.profile_image}"
                app:loadProfileNoCache="@{true}" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/HeadLine18B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@{profile.user.nickname}"
                android:textColor="@color/black_80"
                app:layout_constraintBottom_toBottomOf="@id/ivFixedProfile"
                app:layout_constraintStart_toEndOf="@id/ivFixedProfile"
                app:layout_constraintTop_toTopOf="@id/ivFixedProfile" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="20dp"
                android:src="@drawable/right_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/vFixedProfileDiv"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/black_2"
            app:layout_constraintTop_toBottomOf="@id/clFixedProfile" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="84dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vFixedProfileDiv">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clProfile"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:onClick="@{()-> viewModel.onEventClick(Event.ProfileManage.INSTANCE)}"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivProfile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:loadProfile="@{profile.user.profile_image}"
                        app:loadProfileNoCache="@{true}" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/HeadLine18B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@{profile.user.nickname}"
                        android:textColor="@color/black_80"
                        app:layout_constraintBottom_toBottomOf="@id/ivProfile"
                        app:layout_constraintStart_toEndOf="@id/ivProfile"
                        app:layout_constraintTop_toTopOf="@id/ivProfile" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/right_gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/vProfileDiv"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@color/black_2"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/clProfile" />

                <LinearLayout
                    android:id="@+id/llApplyPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="@{!viewModel.isPlayerModeFlow &amp;&amp; viewModel.isPlayerRequestBtnVisible ? View.VISIBLE : View.GONE}"
                    app:layout_constraintTop_toBottomOf="@id/vProfileDiv">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Paragraph14B"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_s_p100_r4"
                        android:paddingVertical="12dp"
                        android:gravity="center"
                        android:onClick="@{()-> viewModel.onEventClick(Event.JoinPlayer.INSTANCE)}"
                        android:visibility="@{viewModel.isPlayerRequestBtnVisible? View.VISIBLE : View.GONE}"
                        android:text="플레이어 신청"
                        android:textColor="@color/white" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clAccompanyCredit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/background_s_primary10_r4"
                        android:minHeight="40dp"
                        android:onClick="@{()-> viewModel.onEventClick(Event.AccompanyCredit.INSTANCE)}"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:visibility="@{viewModel.isPlayerRequestBtnVisible? View.VISIBLE : View.GONE}">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvAccompanyCredit"
                            style="@style/Paragraph17R"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="동행 크레딧 안내"
                            android:textColor="#F56275"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/right_primary"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="서비스"
                    android:textColor="@color/black_40"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llApplyPlayer" />

                <LinearLayout
                    android:id="@+id/llServices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/tvService">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvUseHistory"
                        style="@style/Paragraph14R"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:onClick="@{()-> viewModel.onEventClick(Event.UseHistory.INSTANCE)}"
                        android:text="이용내역"
                        android:textColor="@color/black_80"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.GONE:View.VISIBLE}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvService" />

                    <View
                        android:id="@+id/vUseHistoryDiv"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:background="@color/black_5"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.GONE:View.VISIBLE}"
                        app:layout_constraintTop_toBottomOf="@id/tvUseHistory" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLikePlayer"
                        style="@style/Paragraph14R"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="20dp"
                        android:gravity="center_vertical"
                        android:onClick="@{()-> viewModel.onEventClick(Event.LikePlayer.INSTANCE)}"
                        android:text="좋아요 한 플레이어"
                        android:textColor="@color/black_80"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.GONE:View.VISIBLE}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/vUseHistoryDiv" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvServiceHistory"
                        style="@style/Paragraph14R"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:onClick="@{()-> viewModel.onEventClick(Event.Settle.INSTANCE)}"
                        android:text="정산내역"
                        android:textColor="@color/black_80"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.VISIBLE:View.GONE}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvService" />

                    <View
                        android:id="@+id/vHistoryDiv"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:background="@color/black_5"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.VISIBLE:View.GONE}"
                        app:layout_constraintTop_toBottomOf="@id/tvServiceHistory" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvFavor"
                        style="@style/Paragraph14R"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="20dp"
                        android:gravity="center_vertical"
                        android:onClick="@{()-> viewModel.onEventClick(Event.Favor.INSTANCE)}"
                        android:text="관심 동행요청"
                        android:textColor="@color/black_80"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.VISIBLE:View.GONE}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/vHistoryDiv" />

                    <View
                        android:id="@+id/vFavorDiv"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:background="@color/black_5"
                        android:visibility="@{viewModel.isPlayerModeFlow?View.VISIBLE:View.GONE}"
                        app:layout_constraintTop_toBottomOf="@id/tvFavor" />

                    
                </LinearLayout>


                <View
                    android:id="@+id/vServiceDiv"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_2"
                    app:layout_constraintTop_toBottomOf="@id/llServices" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="고객지원"
                    android:textColor="@color/black_40"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vServiceDiv" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNotice"
                    style="@style/Paragraph14R"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:onClick="@{()-> viewModel.onEventClick(Event.Notice.INSTANCE)}"
                    android:text="공지사항"
                    android:textColor="@color/black_80"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSupport" />

                <View
                    android:id="@+id/vNoticeDiv"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/black_5"
                    app:layout_constraintTop_toBottomOf="@id/tvNotice" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFaq"
                    style="@style/Paragraph14R"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="20dp"
                    android:gravity="center_vertical"
                    android:onClick="@{()-> viewModel.onEventClick(Event.FAQ.INSTANCE)}"
                    android:text="자주하는 질문"
                    android:textColor="@color/black_80"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vNoticeDiv" />

                <View
                    android:id="@+id/vFaqDiv"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/black_5"
                    app:layout_constraintTop_toBottomOf="@id/tvFaq" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTerm"
                    style="@style/Paragraph14R"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="20dp"
                    android:gravity="center_vertical"
                    android:onClick="@{()-> viewModel.onEventClick(Event.Term.INSTANCE)}"
                    android:text="약관 및 정책"
                    android:textColor="@color/black_80"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vFaqDiv" />

                <View
                    android:id="@+id/vSupportDiv"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_2"
                    app:layout_constraintTop_toBottomOf="@id/tvTerm" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clVersion"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:layout_constraintTop_toBottomOf="@id/vSupportDiv">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvVersionTitle"
                        style="@style/Paragraph14R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="현재 버전"
                        android:textColor="@color/black_40"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvVersion"
                        style="@style/Paragraph14B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="V1.0.0"
                        android:textColor="@color/black_80"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvVersionTitle"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvUpdate"
                        style="@style/Paragraph12B"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/background_s_p100_r4"
                        android:gravity="center"
                        android:onClick="@{()-> viewModel.onEventClick(Event.Update.INSTANCE)}"
                        android:paddingHorizontal="12dp"
                        android:text="업데이트"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/vVersionDiv"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_2"
                    app:layout_constraintTop_toBottomOf="@id/clVersion" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clCompany"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_2"
                    app:layout_constraintTop_toBottomOf="@id/vVersionDiv">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clCompanyHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:onClick="@{()-> viewModel.toggleCompanyInfo()}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCompany"
                            style="@style/Paragraph14B"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="티에이치케이컴퍼니 사업자 정보"
                            android:textColor="@color/black_80"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivCompanyArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_down"
                            app:layout_constraintBottom_toBottomOf="@id/tvCompany"
                            app:layout_constraintStart_toEndOf="@id/tvCompany"
                            app:layout_constraintTop_toTopOf="@id/tvCompany" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCompanyDetail"
                        style="@style/Paragraph14R"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="8dp"
                        android:text="대표 : 홍길동&#10;사업자등록번호 : 250-88-112345&#10;통신판매신고번호 : 22102-12-2323&#10;주소 : 서울시 강남구&#10;이메일 : xxx@xxx.com&#10;전화 : 02-254-2524"
                        android:textColor="@color/black_80"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/clCompanyHeader" />

                    <LinearLayout
                        android:id="@+id/llCompanyLinks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCompanyDetail">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCompanyInfo"
                            style="@style/Paragraph14R"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="사업자정보확인"
                            android:textColor="@color/black_40" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTermDocument"
                            style="@style/Paragraph14R"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="이용약관"
                            android:textColor="@color/black_40" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPrivacy"
                            style="@style/Paragraph14R"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="개인정보처리방침"
                            android:textColor="@color/black_40" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCopyright"
                        style="@style/Description10R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="24dp"
                        android:text="Copyright ⓒTHKCompany Inc.All rights reserved"
                        android:textColor="@color/black_40"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llCompanyLinks" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/llModeChange"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/background_st_b10_s_w_r40"
                    android:onClick="@{()-> viewModel.onModeChange(!viewModel.isPlayerModeFlow)}"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clCompany">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/refresh" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Paragraph14R"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:text="@{viewModel.isPlayerModeFlow?`유저모드 전환`:`플레이어모드 전환`}"
                        android:textColor="@color/black_80" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/llFloatingModeChange"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/background_st_b10_s_w_r40"
            android:onClick="@{()-> viewModel.onModeChange(!viewModel.isPlayerModeFlow)}"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="@{viewModel.isPlayerModeChangeBtnVisible ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/refresh" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:text="@{viewModel.isPlayerModeFlow?`유저모드 전환`:`플레이어모드 전환`}"
                android:textColor="@color/black_80" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
