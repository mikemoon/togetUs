<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.dialog.bottom.BottomAreaSelectViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Paragraph12B"
                android:text="국내"
                android:textColor="@color/selector_b40_white"
                android:onClick="@{()-> viewModel.onAreaSelect(true)}"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/selector_bg_st_b10_b80_s_w_r24"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvForeign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Paragraph12B"
                android:text="해외"
                android:textColor="@color/selector_b40_white"
                android:onClick="@{()-> viewModel.onAreaSelect(false)}"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/selector_bg_st_b10_b80_s_w_r24"
                android:visibility="invisible"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRegion1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HeadLine24B"
                android:text="시/도"
                android:textColor="@color/primary_100"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                style="@style/HeadLine24R"
                android:text=">"
                android:textColor="@color/black_40"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRegion2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HeadLine24R"
                android:text="시/군/구"
                android:textColor="@color/black_40"
                />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDetailDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Paragraph14R"
            android:textColor="@color/black_80"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRegions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="20dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/background_s_p100_r4"
            android:text="선택 완료"
            android:textColor="@color/white"
            style="@style/HeadLine20B"
            android:gravity="center"
            />

    </LinearLayout>
</layout>