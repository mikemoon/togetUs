<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="viewModel" type="sky.kr.co.newtogetusa.ui.main.my.WriteIntroductionViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:onClick="@{()->viewModel.onBackClick()}"
                android:src="@drawable/left_l" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph16B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="자기소개 작성"
                android:textColor="@color/black_80" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etIntroduction"
            style="@style/Paragraph14R"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="20dp"
            android:background="@drawable/background_st_b10_s_w_r4"
            android:gravity="top"
            android:hint="자기소개를 입력해 주세요."
            android:maxLength="500"
            android:onTextChanged="@{(s,st,b,c)->viewModel.updateText(s)}"
            android:padding="12dp"
            android:textColor="@color/black_80" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCount"
            style="@style/Paragraph12R"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="end"
            android:textColor="@color/black_40" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnSave"
            style="@style/Paragraph16B"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="20dp"
            android:background="@drawable/background_s_p100_r4"
            android:gravity="center"
            android:text="저장"
            android:textColor="@color/white" />
    </LinearLayout>
</layout>
