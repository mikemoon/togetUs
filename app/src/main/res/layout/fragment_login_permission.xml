<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="42dp"
            android:src="@drawable/logo"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            style="@style/Paragraph17R"
            android:textAlignment="center"
            android:textColor="@color/black_80"
            android:text="투겟어스 앱 사용을 위해서는\n다음 권한에 대한 동의가 필요합니다."
            />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintBottom_toTopOf="@id/tvConfirm"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="42dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/background_s_b5_r4"
            android:padding="12dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/HeadLine20B"
                    android:textColor="@color/black_80"
                    android:text="선택 접근 권한"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16B"
                    android:textColor="@color/black_80"
                    android:text="위치"
                    android:layout_marginTop="20dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16R"
                    android:textColor="@color/black_80"
                    android:text="유저의 픽업/도착지 자동 입력 및 플레이어의 동행 수행 중 실시간 경로 안내를 위해 사용됩니다."
                    android:layout_marginTop="4dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16B"
                    android:textColor="@color/black_80"
                    android:text="카메라"
                    android:layout_marginTop="20dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16R"
                    android:textColor="@color/black_80"
                    android:text="동행 물품 픽업 및 완료 인증 사진 촬영을 위해 사용됩니다."
                    android:layout_marginTop="4dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16B"
                    android:textColor="@color/black_80"
                    android:text="사진"
                    android:layout_marginTop="20dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16R"
                    android:textColor="@color/black_80"
                    android:text="촬영한 사진을 등록하거나 기기에 저장하기 위해 사용됩니다."
                    android:layout_marginTop="4dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16B"
                    android:textColor="@color/black_80"
                    android:text="알림"
                    android:layout_marginTop="20dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16R"
                    android:textColor="@color/black_80"
                    android:text="매칭 알림, 동행 상태 변경 등 주요 서비스 알림 수신을 위해 사용됩니다."
                    android:layout_marginTop="4dp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph16R"
                    android:textColor="@color/black_40"
                    android:text="- 선택 접근 권한은 동의하지 않아도 해당 기능을 제외한 서비스 이용이 가능합니다.\n
- 단말 내 설정 메뉴에서도 권한 설정 변경이 가능합니다."
                    android:layout_marginTop="20dp"
                    />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvConfirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_cta_height"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/background_s_p100_r4"
            android:gravity="center"
            style="@style/HeadLine18B"
            android:text="확인"
            android:textColor="@color/white"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
