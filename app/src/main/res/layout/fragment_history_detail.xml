<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <!-- 차후 맵뷰자리-->
        <View
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:layout_constraintTop_toTopOf="parent"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/left_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/more_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            />

        <!-- 내용물 start -->
        <LinearLayout
            android:id="@+id/llContentTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/map"
            android:orientation="vertical"
            android:background="@color/white"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Paragraph14B"
                android:text="매칭 대기중"
                android:textColor="@color/black_60"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/background_s_b5_r4"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="노트북 좀 전달해주세요."
                android:textColor="@color/black_80"
                style="@style/HeadLine20B"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23,000원"
                android:textColor="@color/black_80"
                style="@style/HeadLine18R"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="픽업 요청일"
                    android:textColor="@color/black_80"
                    style="@style/Paragraph14B"
                    />
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/black_10"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="2dp"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5월 1일(목) 오전 10:30"
                    android:textColor="@color/black_80"
                    style="@style/Paragraph14R"
                    />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_10"
                android:layout_marginTop="20dp"
                />

        </LinearLayout>
        <!-- 내용물 end -->

        <!-- 이동 경로 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/llContentTop"
            android:paddingVertical="20dp"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                style="@style/HeadLine18B"
                android:text="이동경로"
                android:textColor="@color/black_80"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="예상 주행거리"
                    android:textColor="@color/black_80"
                    style="@style/Paragraph17B"
                    />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/black_10"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph17R"
                    android:text="5km"
                    android:textColor="@color/black_80"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="4dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="예상 소요 시간"
                    android:textColor="@color/black_80"
                    style="@style/Paragraph17B"
                    />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/black_10"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Paragraph17R"
                    android:text="30분"
                    android:textColor="@color/black_80"
                    />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPickup"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/placecircle_primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/Paragraph17B"
                    android:text="픽업지"
                    android:textColor="@color/black_80"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPickup"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvPickup"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="8dp"
                    android:text="서울 강서구 공항대로 631 염창역 2번출구 앞서울 강서구 공항대로 631 염창역 2번출구 앞"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0"
                    style="@style/Paragraph17R"
                    android:textColor="@color/black_80"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/background_s_b5_r4"
                android:gravity="center_vertical"
                android:padding="8dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연락처"
                    style="@style/Paragraph17B"
                    android:textColor="@color/black_80"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="홍길동 010-1234-5678"
                    android:textColor="@color/black_60"
                    android:layout_marginStart="16dp"
                    />
            </LinearLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDestination"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/placecircle_primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDestination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/Paragraph17B"
                    android:text="도착지"
                    android:textColor="@color/black_80"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivDestination"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvDestination"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="8dp"
                    android:text="서울 강서구 공항대로 631 염창역 2번출구 앞서울 강서구 공항대로 631 염창역 2번출구 앞"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0"
                    style="@style/Paragraph17R"
                    android:textColor="@color/black_80"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/background_s_b5_r4"
                android:gravity="center_vertical"
                android:padding="8dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연락처"
                    style="@style/Paragraph17B"
                    android:textColor="@color/black_80"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="홍길동 010-1234-5678"
                    android:textColor="@color/black_60"
                    android:layout_marginStart="16dp"
                    />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>