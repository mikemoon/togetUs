<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.others.terms.PlayerTermViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/HeadLine20B"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="플레이어 약관에 동의해 주세요."
            android:textColor="@color/black_80" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/background_st_b10_s_w_r4"
            android:gravity="center_vertical"
            android:onClick="@{()->viewModel.onAllAgreeClick()}"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:checked="@{viewModel.allAgree}"
                android:button="@null"
                android:background="@drawable/checkbox_selector"
                android:clickable="false"
                android:layout_marginStart="20dp" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/HeadLine18B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="모두 동의"
                android:textColor="@color/black_80" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:onClick="@{()-> viewModel.onAgreeClick(0)}"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:checked="@{viewModel.agree19}"
                android:clickable="false"
                android:background="@drawable/selector_check_round"
                android:button="@null" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="[필수]"
                android:textColor="@color/red_100" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="만 19세 이상입니다."
                android:textColor="@color/black_80" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/right_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:onClick="@{()->viewModel.onAgreeClick(1)}"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:checked="@{viewModel.agreeContract}"
                android:clickable="false"
                android:background="@drawable/selector_check_round"
                android:button="@null" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="[필수]"
                android:textColor="@color/red_100" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="업무위수탁약관"
                android:textColor="@color/black_80" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/right_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:onClick="@{()->viewModel.onAgreeClick(2)}"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:checked="@{viewModel.agreeLocation}"
                android:clickable="false"
                android:background="@drawable/selector_check_round"
                android:button="@null" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="[필수]"
                android:textColor="@color/red_100" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="위치정보 이용 동의"
                android:textColor="@color/black_80" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/right_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:onClick="@{()->viewModel.onAgreeClick(3)}"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:checked="@{viewModel.agreeUnique}"
                android:clickable="false"
                android:background="@drawable/selector_check_round"
                android:button="@null" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="[필수]"
                android:textColor="@color/red_100" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="고유식별정보 수집 및 이용 동의"
                android:textColor="@color/black_80" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/right_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:onClick="@{()->viewModel.onAgreeClick(4)}"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:checked="@{viewModel.agreeThird}"
                android:clickable="false"
                android:background="@drawable/selector_check_round"
                android:button="@null" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="[필수]"
                android:textColor="@color/red_100" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph14R"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="개인 정보의 제3자 제공에 대한 동의"
                android:textColor="@color/black_80" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/right_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="1"
                android:layout_marginBottom="20dp"
                style="@style/HeadLine20B"
                android:gravity="center"
                android:textColor="@color/selector_wopa40_wopa100"
                android:text="약관 동의하기"
                android:enabled="@{viewModel.allAgree}"
                android:background="@drawable/selector_b20_p100_r4"
                android:onClick="@{()-> viewModel.onNextClick(1)}"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>