<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/calendarDayRoot"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/llDeliveryDots"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tvDay"
            app:layout_constraintStart_toStartOf="@id/tvDay"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/vDeliveryDotRed"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/background_s_red100_r20"
                android:visibility="gone" />

            <View
                android:id="@+id/vDeliveryDotGreen"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/background_s_green100_r20"
                android:visibility="gone" />

            <View
                android:id="@+id/vDeliveryDotGray"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/background_s_b20_r20"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/llDeliveryDots"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="12dp"
            android:textColor="@color/black_60"
            tools:text="22" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
