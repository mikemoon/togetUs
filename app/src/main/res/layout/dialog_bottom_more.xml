<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <import type="sky.kr.co.newtogetusa.ui.dialog.bottom.BottomMoreVM.Event"/>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.dialog.bottom.BottomMoreVM" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAction1"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            style="@style/Paragraph17R"
            android:textColor="@color/black_80"
            android:text="삭제하기"
            android:gravity="center_vertical"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAction2"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            style="@style/Paragraph17R"
            android:textColor="@color/black_80"
            android:text="수정하기"
            android:gravity="center_vertical"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAction3"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            style="@style/Paragraph17R"
            android:textColor="@color/black_80"
            android:text="진행중인 채팅"
            android:gravity="center_vertical"
            />
    </LinearLayout>
</layout>
