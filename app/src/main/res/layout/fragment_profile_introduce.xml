<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 자기 소개 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvIntroduceTitle"
                    style="@style/HeadLine18B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자기 소개"
                    android:textColor="@color/black_80"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnEditIntroduction"
                    style="@style/Paragraph16R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="수정"
                    android:textColor="@color/primary_100"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIntroduce"
                style="@style/Paragraph17R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="자기 소개가 없습니다"
                android:textColor="@color/black_40" />

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:background="@color/black_2" />

            <!-- 동행 가능지역 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAreaTitle"
                    style="@style/HeadLine18B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="매일 동행 "
                    android:textColor="@color/black_80"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAreaTitleSub"
                    style="@style/Paragraph16R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(출・퇴근 일상 이동)"
                    android:textColor="@color/black_80"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvAreaTitle"
                    app:layout_constraintStart_toEndOf="@id/tvAreaTitle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnEditArea"
                    style="@style/Paragraph16R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설정"
                    android:textColor="@color/primary_100"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAreaEmpty"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="동행 가능지역이 없습니다"
                android:textColor="@color/black_40"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvArea1"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                tools:text="서울 강서구  >  서울 마포구"
                android:textColor="@color/black_80" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvArea2"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/black_80" />

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:background="@color/black_2" />

            <!-- 추가 지역 설정 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddAreaTitle"
                    style="@style/HeadLine18B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 동행 "
                    android:textColor="@color/black_80"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddAreaTitleSub"
                    style="@style/Paragraph16R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(여행・출장・휴가 이동)"
                    android:textColor="@color/black_80"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvAddAreaTitle"
                    app:layout_constraintStart_toEndOf="@id/tvAddAreaTitle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnEditAddArea"
                    style="@style/Paragraph16R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="추가"
                    android:textColor="@color/primary_100"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddAreaDesc"
                style="@style/Paragraph15R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="여행처럼 잠깐 다른 지역에 갈 때도 동행할 수 있어요.\n날짜와 경로를 등록해두면 맞는 동행을 추천해드려요."
                android:textColor="@color/black_60" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddAreaEmpty"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="추가 지역이 없습니다"
                android:textColor="@color/black_40"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddArea1"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                tools:text="서울 강서구  >  서울 마포구"
                android:textColor="@color/black_80" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddPickupDate1"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                tools:text="픽업 가능일 2025.10.03 - 2025.10.05"
                android:textColor="@color/black_40" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddArea2"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/black_80" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddPickupDate2"
                style="@style/Paragraph16R"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/black_40" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
