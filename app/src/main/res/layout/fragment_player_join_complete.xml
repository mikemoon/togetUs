<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinCompleteViewModel.Event"/>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinCompleteViewModel" />
    </data>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/success_check_primary"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="272dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:text="플레이어 지원이 완료되었어요!"
            android:textColor="@color/black_80"
            style="@style/HeadLine20B"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="40dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:textColor="@color/black_80"
            android:text="지원 내용을 검토한 후, 2~3일 내에 앱 알림으로 결과를 알려드릴게요. 조금만 기다려주세요. :)"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/selector_b20_b80_r4"
                android:textColor="@color/selector_wopa40_wopa100"
                android:text="홈으로 이동"
                style="@style/HeadLine20B"
                android:gravity="center"
                android:onClick="@{()-> viewModel.onEventClick(Event.MoveToHome.INSTANCE)}"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>