<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.history.review.DeliveryReviewViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:onClick="@{()->viewModel.onBackClick()}"
            android:src="@drawable/close" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle"
                    style="@style/HeadLine20B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/HeadLine18R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:text="별점으로 평가해주세요."
                    android:textColor="@color/black_60" />

                <LinearLayout
                    android:id="@+id/llStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStar1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="★"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvStar2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="★"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvStar3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="★"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvStar4"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="★"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvStar5"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="★"
                        android:textSize="32sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/HeadLine18R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="좋았던 부분을 선택해주세요."
                        android:textColor="@color/black_80" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/HeadLine18R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="(선택)"
                        android:textColor="@color/blue_100" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llReasonOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="52dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/HeadLine18R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="거래 후기를 남겨주세요."
                        android:textColor="@color/black_80" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/HeadLine18R"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="(선택)"
                        android:textColor="@color/blue_100" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etReview"
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/background_st_b10_s_w_r4"
                    android:gravity="top|start"
                    android:hint="(선택) 남겨주신 후기는 상대방의 프로필에 공개돼요.&#10;잘못된 정보나 욕설•비방하는 내용은 통보없이 삭제될 수 있어요."
                    android:inputType="textMultiLine"
                    android:maxLength="100"
                    android:onTextChanged="@{(s,st,b,c)->viewModel.onContentChanged(s)}"
                    android:padding="16dp"
                    android:textColor="@color/black_80"
                    android:textColorHint="@color/black_40" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph12R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="@{viewModel.contentCountFlow}"
                    android:textColor="@color/black_20" />
            </LinearLayout>
        </ScrollView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnSubmit"
            style="@style/Paragraph17B"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_cta_height"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/background_s_p100_r4"
            android:gravity="center"
            android:text="등록하기"
            android:textColor="@color/white" />
    </LinearLayout>
</layout>
