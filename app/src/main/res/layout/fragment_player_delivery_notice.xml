<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.history.player.PlayerDeliveryNoticeVM" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/left_l" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Paragraph16B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="동행 유의사항"
                android:textColor="@color/black_80" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. 요청 내용을 충분히 확인하세요."
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="물품 종류, 부피·무게, 픽업/도착지 주소, 대면/비대면 방식 등을 정확히 확인한 후 지원해 주세요."
                    android:textColor="@color/black_60" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="2. 허위 지원 또는 무단 취소는 불이익 대상입니다"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="동행 불가 조건임에도 무리하게 지원하거나, 지원 후 일방 취소를 반복할 경우 서비스 이용 제한 등의 조치가 취해질 수 있습니다."
                    android:textColor="@color/black_60" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="3. 동행은 정해진 시간에 직접 수행해야 합니다."
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="제3자에게 위탁하거나, 지정된 시간 외 동행은 허용되지 않으며 문제 발생 시 책임은 플레이어에게 있습니다."
                    android:textColor="@color/black_60" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="4. 동행 중 물품 파손·분실 시 책임이 따를 수 있습니다."
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="동행 중 발생한 문제에 대한 증빙자료(사진, GPS 등)가 부족할 경우, 보상 책임이 발생할 수 있습니다."
                    android:textColor="@color/black_60" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="5. 해외동행 시 모든 통관 절차 및 세관 문제는 거래 당사자 간 협의 및 책임으로 처리됩니다."
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="수취인이 세관에서의 서류 제출이나 관세 납부를 요구받을 수 있습니다."
                    android:textColor="@color/black_60" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="6. 동행 지원 시, 본인의 한국 계좌로 정산됩니다."
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="동행완료 +N 일 후 회원님의 계좌로 지급됩니다. 본인 명의의 한국 계좌로만 가능하며, 대리 정산은 불가합니다."
                    android:textColor="@color/black_60" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>