<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <import type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinViewModel.Event" />

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/svStep2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toTopOf="@id/tvNext"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/HeadLine20B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:text="입금 계좌 정보를 입력해 주세요."
                    android:textColor="@color/black_80" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/background_s_red5_r4"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Paragraph14B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/error_red"
                        android:drawablePadding="8dp"
                        android:text="반드시 본인 명의의 계좌를 입력해 주세요."
                        android:textColor="@color/red_100" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Paragraph14R"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="입력 정보가 정확하지 않을 경우 정산 지연 또는 실패의 원인이 될 수 있으며, 이에 따른 불이익은 사용자 본인의 책임입니다."
                        android:textColor="@color/red_100" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:text="은행"
                    android:textColor="@color/black_80" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etBank"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/background_st_b10_s_w_r4"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="은행 검색"
                        android:inputType="none"
                        android:padding="16dp"
                        android:textColor="@color/black_80"
                        android:textColorHint="@color/black_40" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:text="계좌번호"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAccountNumber"
                    style="@style/Paragraph14R"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/background_st_b10_s_w_r4"
                    android:hint="계좌번호 입력"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:onClick="@{()-> viewModel.onEventClick(Event.AccountNumber.INSTANCE)}"
                    android:padding="16dp"
                    android:singleLine="true"
                    android:text="@={viewModel.accountNumber}"
                    android:textColor="@color/black_80"
                    android:textColorHint="@color/black_40" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:text="예금주"
                    android:textColor="@color/black_80" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etName"
                    style="@style/Paragraph14R"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/background_st_b10_s_w_r4"
                    android:hint="홍길동"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:enabled="@{viewModel.depositorNameEnabled}"
                    android:focusable="@{viewModel.depositorNameEnabled}"
                    android:focusableInTouchMode="@{viewModel.depositorNameEnabled}"
                    android:clickable="@{viewModel.depositorNameEnabled}"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:singleLine="true"
                    android:text="@={viewModel.depositorName}"
                    android:textColor="@color/black_80"
                    android:textColorHint="@color/black_40" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNext"
            style="@style/HeadLine20B"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_cta_height"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/selector_b20_p100_r4"
            android:enabled="@{viewModel.enableStep2Next}"
            android:gravity="center"
            android:onClick="@{()-> viewModel.onClickStep2Next()}"
            android:text="다음"
            android:textColor="@color/selector_wopa40_wopa100"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
