<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="sky.kr.co.newtogetusa.ui.login.LoginViewModel.Event"/>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.login.LoginViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="158dp"
            android:layout_height="50dp"
            android:src="@drawable/login_log"
            android:layout_gravity="center"
            android:layout_marginTop="131dp"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="동네에서 해외까지"
            android:textColor="@color/black_40"
            style="@style/HeadLine18B"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전국민 물품 배송중개"
            android:textColor="@color/black_80"
            android:layout_gravity="center"
            style="@style/HeadLine24B"
            android:layout_marginTop="4dp"
            />

        <!-- kakao -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_s_fee500_r4"
            android:layout_marginTop="131dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.KakaoLogin.INSTANCE)}"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/login_kakao"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="카카오로 시작하기"
                android:textColor="@color/black_80"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="3dp"
                style="@style/HeadLine18R"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="20dp"
                style="@style/Paragraph12B"
                android:text="최근 로그인"
                android:textColor="@color/primary_100"
                android:background="@drawable/background_s_primary5_r4"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- naver -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_s_03c75a_r4"
            android:layout_marginTop="12dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.NaverLogin.INSTANCE)}"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/login_naver"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="네이버로 시작하기"
                android:textColor="@color/white"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="3dp"
                style="@style/HeadLine18R"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="20dp"
                style="@style/Paragraph12B"
                android:text="최근 로그인"
                android:textColor="@color/primary_100"
                android:background="@drawable/background_s_primary5_r4"
                android:visibility="gone"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- google -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_st_b20_s_w_r4"
            android:layout_marginTop="12dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.GoogleLogin.INSTANCE)}"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/login_google"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="구글로 시작하기"
                android:textColor="@color/black_80"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="3dp"
                style="@style/HeadLine18R"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="20dp"
                style="@style/Paragraph12B"
                android:text="최근 로그인"
                android:textColor="@color/primary_100"
                android:background="@drawable/background_s_primary5_r4"
                android:visibility="gone"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            >
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/black_10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvOr"
                android:layout_marginEnd="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="또는"
                android:textColor="@color/black_40"
                style="@style/Paragraph12R"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/black_10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvOr"
                android:layout_marginStart="20dp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 이메일 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_s_b5_r4"
            android:layout_marginTop="12dp"
            android:onClick="@{()-> viewModel.onEventClick(Event.EmailLogin.INSTANCE)}"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/login_mail"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="이메일로 시작하기"
                android:textColor="@color/black_80"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="3dp"
                style="@style/HeadLine18R"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="20dp"
                style="@style/Paragraph12B"
                android:text="최근 로그인"
                android:textColor="@color/primary_100"
                android:background="@drawable/background_s_primary5_r4"
                android:visibility="gone"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>