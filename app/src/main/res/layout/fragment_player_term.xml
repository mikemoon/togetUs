<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="sky.kr.co.newtogetusa.ui.others.terms.PlayerTermViewModel.Event" />

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.others.terms.PlayerTermViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/clTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:onClick="@{()->viewModel.onEventClick(Event.Back.INSTANCE)}"
                android:src="@drawable/left_l" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="약관 동의"
                android:textColor="@color/black_80"
                android:textSize="16dp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:text="취소"
                    android:textColor="@color/black_60"
                    android:onClick="@{()-> viewModel.onEventClick(Event.Cancel.INSTANCE)}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal"
            >
            <View
                android:id="@+id/vLv0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/selector_bg_b10_b80_r4"
                android:layout_weight="1"
                />
            <View
                android:id="@+id/vLv1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/selector_bg_b10_b80_r4"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                />
            <View
                android:id="@+id/vLv2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/selector_bg_b10_b80_r4"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                />
            <View
                android:id="@+id/vLv3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/selector_bg_b10_b80_r4"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                />
        </LinearLayout>

        <include
            android:id="@+id/layout_lv0"
            layout="@layout/layout_term1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:viewModel="@{viewModel}"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="20dp"
            />

        <include
            android:id="@+id/layout_lv1"
            layout="@layout/layout_term2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:viewModel="@{viewModel}"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="20dp"
            android:visibility="gone"
            />

        <include
            android:id="@+id/layout_lv2"
            layout="@layout/layout_term3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:viewModel="@{viewModel}"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="20dp"
            android:visibility="gone"
            />

        <include
            android:id="@+id/layout_lv3"
            layout="@layout/layout_term4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:viewModel="@{viewModel}"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="20dp"
            android:visibility="gone"
            />
    </LinearLayout>
</layout>