<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_st_b10_s_w_r4"
        android:padding="16dp"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Paragraph12B"
                android:textColor="@color/black_60"
                android:id="@+id/tvStatus"
                android:text="매칭 대기중"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/background_s_b5_r4"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/tvDate"
                android:text="2025.08.01"
                android:textColor="@color/black_40"
                style="@style/Paragraph12R"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPic"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivPic"
                app:layout_constraintEnd_toStartOf="@id/ivRight"
                app:layout_constraintHorizontal_bias="0"
                android:layout_marginStart="16dp"
                android:text="노트북 좀 전달해 주세요."
                android:textColor="@color/black_80"
                style="@style/Paragraph14R"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvContent"
                app:layout_constraintStart_toStartOf="@id/tvContent"
                android:layout_marginTop="4dp"
                android:textColor="@color/black_80"
                android:id="@+id/tvFee"
                android:text="23,000원"
                style="@style/HeadLine18B"
                />
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivRight"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/right_gray"
                />
            
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/background_s_b5_r4"
            android:padding="8dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPickupType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="픽업"
                android:textColor="@color/black_60"
                style="@style/Paragraph12B"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPickupType"
                android:id="@+id/tvPickupDate"
                android:text="2025년 5월 1일(목) 오전 10:30"
                android:textColor="@color/black_80"
                style="@style/Paragraph12R"
                android:layout_marginStart="20dp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/tvImmediate"
                android:text="협의 가능"
                android:textColor="@color/primary_100"
                style="@style/Paragraph12B"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPickup"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/placecircle_primary"
                />

            <View
                android:layout_width="1dp"
                android:layout_height="8dp"
                app:layout_constraintTop_toBottomOf="@id/ivPickup"
                app:layout_constraintStart_toStartOf="@id/ivPickup"
                android:layout_marginStart="8dp"
                android:background="@color/black_10"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDestination"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/ivPickup"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/placecircle_primary"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="픽업지"
                android:textColor="@color/black_40"
                style="@style/Paragraph12R"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivPickup"
                android:layout_marginStart="20dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPickup"
                android:layout_marginStart="16dp"
                android:id="@+id/tvDepartAddress"
                android:text="서울 강서구 공항대로 631"
                android:textColor="@color/black_80"
                style="@style/Paragraph12R"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="도착지"
                android:textColor="@color/black_40"
                style="@style/Paragraph12R"
                app:layout_constraintTop_toBottomOf="@id/tvPickup"
                app:layout_constraintStart_toEndOf="@id/ivPickup"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvPickup"
                app:layout_constraintStart_toEndOf="@id/tvPickup"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:id="@+id/tvDestAddress"
                android:text="서울 강서구 공항대로 631"
                android:textColor="@color/black_80"
                style="@style/Paragraph12R"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>