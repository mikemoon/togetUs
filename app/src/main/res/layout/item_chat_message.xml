<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp">
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSendFailed"
        android:layout_width="48dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toStartOf="@+id/clMessageContents"
        app:layout_constraintBottom_toBottomOf="@+id/clMessageContents"
        android:layout_marginEnd="8dp"
        android:src="@drawable/send_fail"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSending"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintEnd_toStartOf="@+id/clMessageContents"
        app:layout_constraintBottom_toBottomOf="@+id/clMessageContents"
        android:layout_marginEnd="8dp"
        android:src="@drawable/sending_gray"
        android:visibility="gone"
        />
    <TextView
        android:id="@+id/tvMyRead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/clMessageContents"
        app:layout_constraintBottom_toTopOf="@id/tvTimeMy"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        android:textSize="12dp"
        android:textColor="@color/primary_100"
        android:text="@string/no_read_sign"
        tools:text="1"
        />

    <TextView
        android:id="@+id/tvTimeMy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textSize="10sp"
        app:layout_constraintEnd_toStartOf="@+id/clMessageContents"
        app:layout_constraintBottom_toBottomOf="@+id/clMessageContents"
        tools:text="10:30" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMessageContents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:strokeWidth="0dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="12dp"
            app:layout_constraintWidth_max="300dp">

            <TextView
                android:id="@+id/textViewMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/chat_message_my_bg"
                android:textColor="@color/black_80"
                android:textSize="14sp"
                tools:text="안녕하세요! MQTT 채팅 메시지입니다." />
        </com.google.android.material.card.MaterialCardView>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintWidth_max="250dp"
            app:layout_constraintHeight_max="350dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/profile"
            android:background="@drawable/chat_message_sender_bg"
            android:visibility="gone"
            tools:visibility="visible"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivVideoThumnail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintWidth_max="250dp"
                app:layout_constraintHeight_max="350dp"
                android:layout_marginStart="12dp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="@id/ivVideoThumnail"
                app:layout_constraintBottom_toBottomOf="@id/ivVideoThumnail"
                app:layout_constraintStart_toStartOf="@id/ivVideoThumnail"
                app:layout_constraintEnd_toEndOf="@id/ivVideoThumnail"
                android:src="@drawable/thumnail_play"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
