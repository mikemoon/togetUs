<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.history.player.HistoryDeliveryViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:paddingVertical="17dp"
            android:text="동행내역"
            android:textColor="@color/black_80"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/black_5">

            <LinearLayout
                android:id="@+id/llTab"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="@{viewModel.isShowCalendar? View.GONE : View.VISIBLE}"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTopAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_bg_st_b10_b80_s_w_r24"
                    android:text="전체"
                    android:textColor="@color/selector_b40_white"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp"
                    android:onClick="@{()-> viewModel.onTopMenuSelect(viewModel.menuAll)}"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTopDoing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_bg_st_b10_b80_s_w_r24"
                    android:text="거래진행"
                    android:textColor="@color/selector_b40_white"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp"
                    android:onClick="@{()-> viewModel.onTopMenuSelect(viewModel.menuDoing)}"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTopEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_bg_st_b10_b80_s_w_r24"
                    android:text="거래종료"
                    android:textColor="@color/selector_b40_white"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp"
                    android:onClick="@{()-> viewModel.onTopMenuSelect(viewModel.menuEnd)}"
                    />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@id/llTab"
                android:background="@drawable/background_st_b10_s_w_r4"
                android:visibility="@{viewModel.isShowCalendar? View.GONE : View.VISIBLE}"
                >

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingVertical="14dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="42dp"
                    android:textColorHint="@color/black_40"
                    android:hint="제목 검색"
                    style="@style/Paragraph14R"
                    android:background="@null"
                    />
                
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="12dp"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/icCalendar"
                layout="@layout/include_calendar"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{viewModel.isShowCalendar? View.VISIBLE : View.GONE}"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/clSearch"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="29dp"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/background_st_b10_s_w_r40"
                    android:onClick="@{()-> viewModel.onShowCalendar(!viewModel.isShowCalendar)}"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/refresh" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Paragraph14R"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:text="@{viewModel.isShowCalendar?`목록으로 보기`:`캘린더로 보기`}"
                        android:textColor="@color/black_80" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>