<?xml version="1.0" encoding="utf-8"?>
 <layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <import type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinViewModel.Event" />

        <variable
            name="viewModel"
            type="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinViewModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Topbar start-->
        <LinearLayout
            android:id="@+id/clTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:onClick="@{()->viewModel.onEventClick(Event.Back.INSTANCE)}"
                android:src="@drawable/left_l" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@{viewModel.stepTitle}"
                android:textColor="@color/black_80"
                android:textSize="16dp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Paragraph16B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:text="취소"
                    android:textColor="@color/black_60"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <!-- Topbar end-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_margin="20dp"
            android:orientation="horizontal">

            <View
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@{viewModel.step >= 1? @drawable/background_s_p100_r4 : @drawable/background_s_b10_r4}" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@{viewModel.step >= 2? @drawable/background_s_p100_r4 : @drawable/background_s_b10_r4}"
                />

            <View
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@{viewModel.step >= 3? @drawable/background_s_p100_r4 : @drawable/background_s_b10_r4}"
                />

            <View
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@{viewModel.step >= 4? @drawable/background_s_p100_r4 : @drawable/background_s_b10_r4}"
                />
        </LinearLayout>

        <!-- step1 start -->
        <include
            layout="@layout/layout_player_join_step1"
            android:visibility="@{viewModel.step == 1 ? View.VISIBLE : View.GONE}"
            viewModel="@{viewModel}"
            />

        <include
            android:id="@+id/icStep2"
            layout="@layout/layout_player_join_step2"
            android:visibility="@{viewModel.step == 2 ? View.VISIBLE : View.GONE}"
            viewModel="@{viewModel}"
            />

        <include
            android:id="@+id/icStep3"
            layout="@layout/layout_player_join_step3"
            android:visibility="@{viewModel.step == 3 ? View.VISIBLE : View.GONE}"
            viewModel="@{viewModel}"
            />

        <include
            android:id="@+id/icStep4"
            layout="@layout/layout_player_join_step4"
            android:visibility="@{viewModel.step == 4 ? View.VISIBLE : View.GONE}"
            viewModel="@{viewModel}"
            />

    </LinearLayout>
</layout>