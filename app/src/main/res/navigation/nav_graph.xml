<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home">

    <include app:graph="@navigation/home"/>
    <include app:graph="@navigation/search"/>
    <include app:graph="@navigation/history"/>
    <include app:graph="@navigation/chat"/>
    <include app:graph="@navigation/my"/>

    <fragment
        android:id="@+id/historyDetailFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.HistoryDetailFragment"
        android:label="HistoryDetailFragment" >
        <argument
            android:name="delivery"
            app:argType="sky.kr.co.newtogetusa.data.remote.dto.delivery.DeliverySummaryDto"
            app:nullable="true"
            android:defaultValue="@null"
            />
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_historyDetailFragment_to_photoFragment"
            app:destination="@id/photoFragment" />
        <action
            android:id="@+id/action_historyDetailFragment_to_deliveryFeeEditFragment"
            app:destination="@id/deliveryFeeEditFragment" />
        <action
            android:id="@+id/action_historyDetailFragment_to_mapDetailFragment"
            app:destination="@id/mapDetailFragment" />
        <action
            android:id="@+id/action_historyDetailFragment_to_deliveryStatusFragment"
            app:destination="@id/deliveryStatusFragment" />
        <action
            android:id="@+id/action_historyDetailFragment_to_deliveryReviewFragment"
            app:destination="@id/deliveryReviewFragment" />
        <action
            android:id="@+id/action_historyDetailFragment_to_receivedReviewFragment"
            app:destination="@id/receivedReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/deliveryStatusFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.status.DeliveryStatusFragment"
        android:label="DeliveryStatusFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/deliveryReviewFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.review.DeliveryReviewFragment"
        android:label="DeliveryReviewFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
        <argument
            android:name="isPlayer"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_deliveryReviewFragment_to_receivedReviewFragment"
            app:destination="@id/receivedReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/sentReviewFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.review.SentReviewFragment"
        android:label="SentReviewFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
        <argument
            android:name="isPlayer"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_sentReviewFragment_to_receivedReviewFragment"
            app:destination="@id/receivedReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/receivedReviewFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.review.ReceivedReviewFragment"
        android:label="ReceivedReviewFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
        <argument
            android:name="isPlayer"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <action
        android:id="@+id/action_global_home"
        app:destination="@id/home"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="false" />

    <action
        android:id="@+id/action_global_historyDetailFragment"
        app:destination="@id/historyDetailFragment"
        app:launchSingleTop="true"/>

    <action
        android:id="@+id/action_global_playerHistoryDetailFragment"
        app:destination="@id/playerHistoryDetailFragment"
        app:launchSingleTop="true">
        <argument
            android:name="deliveryId"
            app:argType="long" />
    </action>

    <action
        android:id="@+id/action_global_chatInProgressFragment"
        app:destination="@id/globalChatInProgressFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
        <argument
            android:name="isSelectMode"
            app:argType="boolean"
            android:defaultValue="true" />
    </action>

    <action
        android:id="@+id/action_global_deliveryStatusFragment"
        app:destination="@id/deliveryStatusFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
    </action>

    <fragment
        android:id="@+id/globalChatInProgressFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.chat.ChatInProgressFragment"
        android:label="ChatInProgressFragment">
        <argument
            android:name="deliveryId"
            app:argType="long" />
        <argument
            android:name="isSelectMode"
            app:argType="boolean"
            android:defaultValue="true" />
    </fragment>

    <action
        android:id="@+id/action_global_profileManagementFragment"
        app:destination="@id/profileManagementFragment"
        app:launchSingleTop="true">
        <argument
            android:name="profileDto"
            app:argType="sky.kr.co.newtogetusa.data.remote.dto.users.ProfileDto"
            app:nullable="true" />
        <argument
            android:name="isPlayer"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="isFromSearchResult"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
    </action>

    <action
        android:id="@+id/action_global_historyFragment"
        app:destination="@id/history">
        <argument
            android:name="fromMySubMenu"
            app:argType="boolean"
            android:defaultValue="false" />
    </action>

    <action
        android:id="@+id/action_global_playerAreaSettingFragment"
        app:destination="@id/globalPlayerAreaSettingFragment" />

    <fragment
        android:id="@+id/globalPlayerAreaSettingFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.my.PlayerAreaSettingFragment"
        android:label="PlayerAreaSettingFragment" />

    <action
        android:id="@+id/action_global_playerJoinSearchFragment"
        app:destination="@id/globalPlayerJoinSearchFragment" />

    <fragment
        android:id="@+id/globalPlayerJoinSearchFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.my.joinPlayer.PlayerJoinSearchFragment"
        android:label="PlayerJoinSearchFragment">
        <argument
            android:name="isStart"
            app:argType="boolean" />
        <argument
            android:name="isSecondary"
            app:argType="boolean" />
    </fragment>

    <action
        android:id="@+id/action_global_selectDateRangeFragment"
        app:destination="@id/globalSelectDateRangeFragment" />

    <fragment
        android:id="@+id/globalSelectDateRangeFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.my.SelectDateRangeFragment"
        android:label="SelectDateRangeFragment" />

    <action
        android:id="@+id/action_global_to_home_for_delivery"
        app:destination="@id/home"
        app:popUpTo="@id/historyDetailFragment"
        app:popUpToInclusive="false">
        <argument
            android:name="openDeliveryReq"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="returnToHistory"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="returnToDetail"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="isEdit"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
    </action>

    <action
        android:id="@+id/action_global_deliveryFeeFragment"
        app:destination="@id/deliveryFeeEditFragment">
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
    </action>

    <fragment
        android:id="@+id/deliveryFeeEditFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.delivery.DeliveryFeeEditFragment"
        android:label="DeliveryFeeFragment">
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <action
        android:id="@+id/action_global_deliveryFeeAgreementFragment"
        app:destination="@id/deliveryFeeAgreementFragment" />

    <action
        android:id="@+id/action_global_deliveryPayFragment"
        app:destination="@id/deliveryPayFragment" />

    <action
        android:id="@+id/action_global_takePhotoFragment"
        app:destination="@id/takePhotoFragment" />

    <action
        android:id="@+id/action_global_noPictureFragment"
        app:destination="@id/noPictureFragment" />

    <fragment
        android:id="@+id/deliveryFeeAgreementFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.delivery.DeliveryFeeAgreementFragment"
        android:label="DeliveryFeeAgreementFragment" />

    <fragment
        android:id="@+id/deliveryPayFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.delivery.DeliveryPayFragment"
        android:label="DeliveryPayFragment">
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="playerId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/takePhotoFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.global.TakePhotoFragment"
        android:label="TakePhotoFragment">
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="proofType"
            app:argType="string"
            android:defaultValue="complete" />
    </fragment>

    <fragment
        android:id="@+id/noPictureFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.global.NoPictureFragment"
        android:label="NoPictureFragment">
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="proofType"
            app:argType="string"
            android:defaultValue="complete" />
    </fragment>

    <fragment
        android:id="@+id/photoFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.PhotoFragment"
        android:label="PhotoFragment" >
        <argument
            android:name="images"
            app:argType="string[]"
            />
    </fragment>

    <fragment
        android:id="@+id/deliveryAddressMapFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.delivery.DeliveryAddressMapFragment"
        android:label="DeliveryAddressMapFragment">

        <argument
            android:name="isStart"
            app:argType="boolean"
            android:defaultValue="true" />

        <argument
            android:name="isInternational"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <action
        android:id="@+id/action_global_deliveryAddressMapFragment"
        app:destination="@id/deliveryAddressMapFragment" />


    <action
        android:id="@+id/action_global_chattingConversationFragment"
        app:destination="@id/chattingConversationFragment"
        app:launchSingleTop="true">
        <argument
            android:name="roomId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="isPlayerRoom"
            app:argType="boolean"
            android:defaultValue="false" />
    </action>

    <fragment
        android:id="@+id/chattingConversationFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.chat.ChattingConversationFragment"
        android:label="ChattingConversationFragment">
        <deepLink app:uri="togetus://chat-room/{roomId}" />
        <argument android:name="roomId" app:argType="long" android:defaultValue="-1L" />
        <argument android:name="isPlayerRoom" app:argType="boolean" android:defaultValue="false" />
        <action
            android:id="@+id/action_chattingConversationFragment_to_chattingImageDetailFragment"
            app:destination="@id/chattingImageDetailFragment">
            <argument android:name="imageUrl" app:argType="string" />
        </action>
        <action
            android:id="@+id/action_chattingConversationFragment_to_chattingVideoDetailFragment"
            app:destination="@id/chattingVideoDetailFragment">
            <argument android:name="videoUrl" app:argType="string" />
        </action>
        <action
            android:id="@+id/action_chattingConversationFragment_to_chattingReportFragment"
            app:destination="@id/chattingReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/chattingImageDetailFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.chat.detail.ChattingImageDetailFragment"
        android:label="ChattingImageDetailFragment">
        <argument android:name="imageUrl" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/chattingVideoDetailFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.chat.detail.ChattingVideoDetailFragment"
        android:label="ChattingVideoDetailFragment">
        <argument android:name="videoUrl" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/chattingReportFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.chat.detail.ChattingReportFragment"
        android:label="ChattingReportFragment">
        <argument android:name="roomId" app:argType="long" android:defaultValue="-1L" />
        <action
            android:id="@+id/action_chattingReportFragment_to_chattingReportDetailFragment"
            app:destination="@id/chattingReportDetailFragment">
            <argument android:name="roomId" app:argType="long" />
            <argument android:name="reasonType" app:argType="integer" />
            <argument android:name="reason" app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/chattingReportDetailFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.chat.detail.ChattingReportDetailFragment"
        android:label="ChattingReportDetailFragment">
        <argument android:name="roomId" app:argType="long" />
        <argument android:name="reasonType" app:argType="integer" />
        <argument android:name="reason" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/mapDetailFragment"
        android:name="sky.kr.co.newtogetusa.ui.main.history.MapDetailFragment"
        android:label="MapDetailFragment">
        <argument
            android:name="startLat"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="startLng"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="endLat"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="endLng"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="startAddress"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="endAddress"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="deliveryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="statusCd"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="playerNickname"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="playerProfileImage"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>
